# Unignore source libraries
!apps/web/lib/

# SQLite & Data Files
*.sqlite3
*.db
*.db-journal
*.sqlite
data/raw/*
!data/raw/.gitkeep
data/cleaned/*
!data/cleaned/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/exports/*
!data/exports/.gitkeep
data/cache/*
!data/cache/.gitkeep
data/downloads/*
!data/downloads/.gitkeep
data/epochs/*
!data/epochs/.gitkeep
data/features/*
!data/features/.gitkeep

# Large Scientific Data Recordings (never commit raw datasets)
*.edf
*.bdf
*.fif
*.fif.gz
*.vhdr
*.vmrk
!data/fixtures/*.edf
!data/fixtures/*.fif
!data/fixtures/*.json


# Trained Model Binaries
models/baseline/*
!models/baseline/.gitkeep
models/lda/*
!models/lda/.gitkeep
models/svm/*
!models/svm/.gitkeep
models/eegnet/*
!models/eegnet/.gitkeep
models/production/*
!models/production/.gitkeep

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Operating System & IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Test Reports
test-results/
scratch/

playwright-report/
blob-report/
playwright/.cache/
