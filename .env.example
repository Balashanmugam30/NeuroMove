# NeuroMove Environment Configuration Template
# Copy this file to .env or .env.local for local development.

# Application Environment (development, staging, production, test)
APP_ENV=development

# Operating Mode: SIMULATION | REPLAY | LIVE
# Defaults to SIMULATION to ensure no hardware is triggered accidentally.
NEUROMOVE_MODE=SIMULATION

# Core FastAPI API Server Configuration
API_HOST=127.0.0.1
API_PORT=8000

# Web Dashboard Configuration
WEB_HOST=localhost
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Persistence (SQLite ready)
DATABASE_URL=sqlite:///./data/neuromove.db

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Safety & Control Station Flags
ENABLE_HARDWARE_INTERFACE=false
REQUIRE_EXPLICIT_SAFETY_OVERRIDE=false
